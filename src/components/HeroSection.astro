---
import { Image } from "astro:assets";
---

<div class="flex flex-grow flex-col justify-center items-center p-4">
  <div class="relative max-w-xl bg-noise">
    <div class="bg-gradient"></div>
    <Image
      src={"/assets/siro-diaz.png"}
      alt="profile"
      width={200}
      height={200}
      class="mb-6"
    />
    <h1 class="font-black text-3xl text-white">Siro Díaz Palazón</h1>
    <h2 class="font-bold text-neutral-300 mt-1">
      Frontend software Engineer @Sportian
    </h2>
    <p class="text-xl text-neutral-400 mt-2 mb-8">
      Hi, I'm Siro. I'm a frontend software engineer at
      <a
        class="link link-hover text-white font-bold"
        target="_blank"
        rel="noopener noreferrer nofollow"
        href="https://sportian.com">Sportian</a
      >. I love to code, craft new amazing stuff and share my knowledge with
      others. I'm a self-taught and curious person about everything that can be
      done with code, SEO and a good UX.
    </p>

    <div class="flex flex-row gap-4 items-center my-2">
      <span class="text-white font-bold text-xl">Projects</span>
      <a
        href="https://skinclaireroutine.com"
        target="_blank"
        class="link link-hover text-neutral-400 transition-all duration-300 hover:text-white hover:animate-pulse"
      >
        SkinClaireRoutine
      </a>
    </div>

    <section class="flex flex-grow-0 flex-row items-center gap-4 my-2">
      <h2 class="text-xl text-white font-bold">Find me on</h2>

      <ul class="flex gap-4">
        <li>
          <a
            href="https://github.com/siro-diaz"
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="link link-hover text-neutral-400 transition-all duration-300 hover:text-white hover:animate-pulse"
            >GitHub</a
          >
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/siro-diaz/"
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="link link-hover text-neutral-400 transition-all duration-300 hover:text-white hover:animate-pulse"
            >LinkedIn</a
          >
        </li>
      </ul>
    </section>
  </div>
</div>

<style>
  .bg-noise {
    @apply bg-no-repeat bg-cover bg-center bg-fixed rounded-full;
    background-image: url("data:image/svg+xml;base64,");
  }
  .bg-gradient {
    @apply blur-xl rounded-full;
    z-index: -1;
    width: 50%;
    padding: 2rem;
    height: 80%;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: #0e0d0d; /* fallback for old browsers */
    background: -webkit-linear-gradient(
      to left,
      #0e0d0d,
      #020202
    ); /* Chrome 10-25, Safari 5.1-6 */
    background: linear-gradient(
      to left,
      #080808,
      #020202
    ); /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
  }
</style>
